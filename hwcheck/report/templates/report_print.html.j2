<!DOCTYPE html>
{# Печатная версия отчёта для PDF (QTextDocument без движка браузера; SPEC 1.3 — 25.4,
   SPEC_V2_1 — этап 48). QTextDocument понимает только часть HTML/CSS: плашки и полосы —
   таблицами, графики — картинками chart_N.png (рисуются из SVG через QtSvg). У больших
   таблиц заголовок в <thead>: QTextDocument повторяет его на каждой странице.
   Содержимое — то же, что в HTML: сначала вид покупателя, затем полный технический протокол. #}
<html lang="ru">
<head>
<meta charset="utf-8">
<style>
  body { font-family: "Segoe UI", Arial, sans-serif; color: #1d1d1f; font-size: 9.5pt; }
  h1 { font-size: 15pt; margin-top: 0; margin-bottom: 4px; }
  h2 { font-size: 12pt; margin-top: 16px; margin-bottom: 6px; }
  h3 { font-size: 10.5pt; margin-top: 12px; margin-bottom: 4px; }
  p { margin-top: 2px; margin-bottom: 4px; }
  li { margin-bottom: 2px; }
  .meta { color: #555555; font-size: 8.5pt; }
  .digest { font-family: Consolas, monospace; font-size: 8pt; }
  .small { color: #666666; font-size: 8pt; }
  th { background-color: #f4f4f6; font-weight: 600; text-align: left; }
  .critical { color: #b3261e; font-weight: 600; } .warning { color: #b26a00; }
  .info { color: #3b5bab; } .ok { color: #1b7f3b; }
</style>
</head>
<body>

<h1>{{ app_name }} — отчёт о проверке компьютера</h1>
<p class="meta">Номер отчёта {{ report_id }} · проверка {{ started_at }} · создан {{ generated_at }} · {{ buyer.mode }} · версия {{ version }}<br>
SHA-256 данных проверки <span class="digest">{{ digest }}</span></p>
{% if demo %}
<table width="100%" cellspacing="0" cellpadding="6" bgcolor="#fff3cd"><tr><td><b>Демо-режим.</b> Данные взяты из учебного сценария «{{ demo }}», а не с настоящего компьютера.</td></tr></table>
{% endif %}

<h2>{{ mode_buyer_title }}</h2>
<table width="100%" cellspacing="0" cellpadding="12" bgcolor="{{ decision_color }}" style="margin-top: 6px;">
  <tr><td><span style="color: #ffffff; font-size: 20pt; font-weight: 700;">{{ buyer.decision_title | upper }}</span><br>
  <span style="color: #ffffff; font-size: 11pt;">{{ buyer.summary }}</span></td></tr>
</table>

<h3>Главные причины</h3>
<ul>
{% for r in buyer.reasons %}  <li><span class="{{ r.severity_key }}">{{ r.severity }}:</span> <b>{{ r.title }}.</b> {{ r.explanation }}</li>
{% endfor %}
</ul>

<h3>Состояние компонентов</h3>
<table width="100%" border="1" cellspacing="0" cellpadding="3">
  <thead><tr><th>Компонент</th><th>Состояние</th><th>Почему</th><th>Уверенность</th></tr></thead>
{% for c in buyer.components %}
  <tr><td>{{ c.name }}</td><td>{{ c.state }}</td><td>{{ c.text }}</td><td>{{ c.confidence }}</td></tr>
{% endfor %}
</table>

{% if buyer.problems %}
<h3>Найденные проблемы и что они значат</h3>
<ul>
{% for p in buyer.problems %}  <li><b>{{ p.title }}.</b> {{ p.explanation }}{% if p.impact %} <i>Для покупки:</i> {{ p.impact }}{% endif %}{% if p.advice %} <i>Что делать:</i> {{ p.advice }}{% endif %}</li>
{% endfor %}
</ul>
{% endif %}
{% if buyer.listing_mismatches %}
<h3>Несовпадения с объявлением</h3>
<ul>
{% for m in buyer.listing_mismatches %}  <li><b>{{ m.title }}.</b> {{ m.explanation }}</li>
{% endfor %}
</ul>
{% endif %}
<h3>Что не удалось проверить</h3>
{% if buyer.not_checked %}
<ul>
{% for item in buyer.not_checked %}  <li>{{ item }}</li>
{% endfor %}
</ul>
{% else %}
<p>Все запланированные проверки выполнены.</p>
{% endif %}
{% if laptop %}
<h3>Ноутбук</h3>
<table width="100%" border="1" cellspacing="0" cellpadding="3">
{% for label, text in laptop %}  <tr><th width="30%">{{ label }}</th><td>{{ text }}</td></tr>
{% endfor %}
</table>
{% endif %}
<h3>Что проверить перед оплатой</h3>
<ul>
{% for item in buyer.manual_checks %}  <li>{{ item }}</li>
{% endfor %}
</ul>
{% if buyer.bargaining %}
<h3>Аргументы для торга</h3>
<ul>
{% for point in buyer.bargaining %}  <li>{{ point }}</li>
{% endfor %}
</ul>
{% endif %}

<h2>{{ mode_specialist_title }}</h2>
{% for section in [passport] + sections %}
<h3>{{ section.title }}</h3>
<table width="100%" border="1" cellspacing="0" cellpadding="2" style="font-size: 8pt;">
  <thead><tr><th width="21%">Параметр</th><th width="24%">Значение</th><th width="17%">Источник</th><th width="14%">Статус</th><th>Пояснение</th></tr></thead>
{% for row in section.rows %}
  <tr><td>{{ row.label }}</td><td>{{ row.value }}</td><td>{{ row.source }}</td><td>{{ row.status_name }}</td><td>{{ row.note }}</td></tr>
{% endfor %}
</table>
{% endfor %}

<h3>Тесты</h3>
<table width="100%" border="1" cellspacing="0" cellpadding="2" style="font-size: 8pt;">
  <thead><tr><th>Тест</th><th>Состояние</th><th>Начало и длительность</th><th>Метрики</th><th>Отметки и заметки</th></tr></thead>
{% for t in tests %}
  <tr><td>{{ t.name }}</td><td>{{ t.state }}</td><td>{{ t.started }}<br>{{ t.duration }}</td>
    <td>{% for key, value in t.metrics %}{{ key }}: {{ value }}{% if not loop.last %}<br>{% endif %}{% endfor %}</td>
    <td>{% for m in t.markers %}{{ m }}<br>{% endfor %}{% for note in t.notes %}{{ note }}<br>{% endfor %}</td></tr>
{% endfor %}
</table>

{% if chart_images %}
<h3>Графики датчиков под нагрузкой</h3>
{% for chart in chart_images %}
<p class="small"><b>{{ chart.title }}</b>, {{ chart.unit }} — {{ chart.period }}</p>
<p><img src="{{ chart.src }}" width="{{ chart.width }}" height="{{ chart.height }}"></p>
{% endfor %}
{% endif %}

{% if events %}
<h3>Журнал Windows за {{ events.days }} дней</h3>
<table width="100%" border="1" cellspacing="0" cellpadding="2" style="font-size: 8pt;">
  <thead><tr><th>Событие</th><th>Сколько раз</th><th>Последний раз</th></tr></thead>
{% for e in events.rows %}  <tr><td>{{ e.name }}</td><td>{{ e.count }}</td><td>{{ e.last }}</td></tr>
{% endfor %}
</table>
{% if events["items"] %}
<table width="100%" border="1" cellspacing="0" cellpadding="2" style="font-size: 7.5pt;">
  <thead><tr><th>Группа</th><th>Источник</th><th>ID</th><th>Уровень</th><th>Раз</th><th>Первое — последнее</th><th>Что это</th><th>Компонент</th><th>Значимость</th></tr></thead>
{% for e in events["items"] %}  <tr><td>{{ e.group }}</td><td>{{ e.provider }}</td><td>{{ e.event_id }}</td><td>{{ e.level }}</td><td>{{ e.count }}</td><td>{{ e.first }} — {{ e.last }}</td><td>{{ e.title }}{% if e.note %}<br>{{ e.note }}{% endif %}</td><td>{{ e.component }}</td><td>{{ e.significance }}</td></tr>
{% endfor %}
</table>
{% endif %}
{% endif %}

{% if listing %}
<h3>Объявление</h3>
<table width="100%" border="1" cellspacing="0" cellpadding="3">
  <tr><th width="25%">Заголовок</th><td>{{ listing.title }}</td></tr>
  {% if listing.url %}<tr><th>Адрес страницы</th><td>{{ listing.url }}</td></tr>{% endif %}
  <tr><th>Цена</th><td>{{ listing.price }}{% if listing.market_count %} (средняя на рынке {{ listing.market }}, объявлений: {{ listing.market_count }}){% endif %}</td></tr>
  <tr><th>Заявлено</th><td>{{ listing.claimed }}</td></tr>
</table>
{% endif %}

<h3>Оценка компонентов</h3>
<table width="100%" border="1" cellspacing="0" cellpadding="2" style="font-size: 8pt;">
  <thead><tr><th>Компонент</th><th>Состояние</th><th>Уверенность</th><th>Причина</th><th>Основание</th><th>Не проверено</th></tr></thead>
{% for a in assessments %}  <tr><td>{{ a.name }}</td><td>{{ a.state }}</td><td>{{ a.confidence }}</td><td>{{ a.reason }}</td><td>{{ a.facts | join("; ") or "—" }}</td><td>{{ a.not_checked | join("; ") or "—" }}</td></tr>
{% endfor %}
</table>

<h3>Находки и правила вердикта</h3>
<table width="100%" border="1" cellspacing="0" cellpadding="2" style="font-size: 8pt;">
  <thead><tr><th>Правило</th><th>Важность</th><th>Находка</th><th>Основание</th><th>Влияние на покупку</th><th>Ограничения вывода</th></tr></thead>
{% for f in findings %}  <tr><td>{{ f.rule }}</td><td>{{ f.severity }}</td><td><b>{{ f.title }}.</b> {{ f.explanation }}</td><td>{{ f.evidence }}</td><td>{{ f.impact or "—" }}</td><td>{{ f.limitations or "—" }}</td></tr>
{% endfor %}
</table>

<h3>Неполученные данные и ограничения</h3>
<table width="100%" border="1" cellspacing="0" cellpadding="2" style="font-size: 8pt;">
  <thead><tr><th>Раздел</th><th>Параметр</th><th>Статус</th><th>Причина</th></tr></thead>
{% for title, row in missing %}  <tr><td>{{ title }}</td><td>{{ row.label }}</td><td>{{ row.status_name }}</td><td>{{ row.note }}</td></tr>
{% endfor %}
</table>

<h3>Источники данных</h3>
<p class="small">{{ sources | join("; ") }}</p>

<p class="meta" style="margin-top: 20px;">
  Ни одна программа не даёт 100% гарантии: подготовленный продавец может временно скрыть часть проблем.
  Отчёт снижает риск, но не заменяет здравый смысл — договаривайтесь о гарантии и не переводите деньги заранее.
  Нули вместо отсутствующих данных не подставляются; программные датчики не являются лабораторным измерением.
  <br>Отчёт создан программой {{ app_name }} {{ version }}. Программа ничего не устанавливала на проверяемый компьютер.
</p>

</body>
</html>
