<!DOCTYPE html>
{# PDF-версия отчёта для QTextDocument (без движка браузера, SPEC 1.3 — 25.4).
   QTextDocument понимает только часть HTML/CSS, поэтому плашки и полосы — таблицами,
   отступы — явно, графики — картинками (chart_N.png, рисуются из SVG через QtSvg). #}
<html lang="ru">
<head>
<meta charset="utf-8">
<style>
  body { font-family: "Segoe UI", Arial, sans-serif; color: #1d1d1f; font-size: 10pt; }
  h1 { font-size: 15pt; margin-top: 0; margin-bottom: 4px; }
  h2 { font-size: 12pt; margin-top: 16px; margin-bottom: 6px; }
  p { margin-top: 2px; margin-bottom: 4px; }
  li { margin-bottom: 2px; }
  .meta { color: #555555; font-size: 8.5pt; }
  .digest { font-family: Consolas, monospace; font-size: 8pt; }
  .tag { font-size: 7.5pt; font-weight: 600; }
  .ftitle { font-weight: 600; font-size: 10.5pt; }
  .small { color: #777777; font-size: 8pt; }
  .good { color: #1b7f3b; }
  th { background-color: #f4f4f6; font-weight: 600; text-align: left; }
  .status-passed { color: #1b7f3b; } .status-failed { color: #b3261e; font-weight: 600; }
  .status-warning { color: #b26a00; } .status-skipped, .status-error { color: #777777; }
</style>
</head>
<body>

<h1>{{ app_name }} — отчёт о проверке компьютера</h1>
<table class="meta" cellspacing="0" cellpadding="1">
  <tr><td width="190">Номер отчёта</td><td>{{ report_id }}</td></tr>
  <tr><td>Дата проверки</td><td>{{ started_at }}</td></tr>
  <tr><td>Отчёт создан</td><td>{{ generated_at }}</td></tr>
  <tr><td>Режим</td><td>{{ mode }}</td></tr>
  <tr><td>Версия программы</td><td>{{ version }}</td></tr>
  <tr><td>SHA-256 данных проверки</td><td class="digest">{{ digest }}</td></tr>
</table>

{% if demo %}
<table width="100%" cellspacing="0" cellpadding="6" bgcolor="#fff3cd" style="margin-top: 10px;">
  <tr><td><b>Демо-режим.</b> Данные взяты из учебного сценария «{{ demo }}», а не с настоящего компьютера.</td></tr>
</table>
{% endif %}

<table width="100%" cellspacing="0" cellpadding="12" bgcolor="{{ decision_color }}" style="margin-top: 12px; margin-bottom: 4px;">
  <tr><td><span style="color: #ffffff; font-size: 20pt; font-weight: 700;">{{ decision_title | upper }}</span><br>
  <span style="color: #ffffff; font-size: 11pt;">{{ summary }}</span></td></tr>
</table>

<h2>Причины</h2>
{% for f in problems %}
<table width="100%" cellspacing="0" cellpadding="0" style="margin-bottom: 8px;">
  <tr>
    <td width="4" bgcolor="{{ severity_colors[f.severity.value] }}"></td>
    <td style="padding-left: 10px; padding-top: 2px; padding-bottom: 2px;">
      <span class="tag" style="color: {{ severity_colors[f.severity.value] }};">{{ severity_names[f.severity.value] | upper }}</span><br>
      <span class="ftitle">{{ f.title }}</span><br>
      {{ f.explanation }}
      {% if f.advice %}<br><b>Что делать:</b> {{ f.advice }}{% endif %}
      {% if f.evidence %}<br><span class="small">Данные: {{ f.evidence }}</span>{% endif %}
    </td>
  </tr>
</table>
{% else %}
<p>Проблем не найдено.</p>
{% endfor %}

{% if good %}
<h2>В порядке</h2>
<ul>
{% for f in good %}  <li class="good"><b>{{ f.title }}.</b> {{ f.explanation }}</li>
{% endfor %}
</ul>
{% endif %}

{% if bargaining %}
<h2>Аргументы для торга</h2>
<ul>
{% for point in bargaining %}  <li>{{ point }}</li>
{% endfor %}
</ul>
{% endif %}

<h2>Что не удалось проверить</h2>
{% if not_checked %}
<ul>
{% for item in not_checked %}  <li>{{ item }}</li>
{% endfor %}
</ul>
{% else %}
<p>Все запланированные проверки выполнены.</p>
{% endif %}

{% if listing %}
<h2>Объявление</h2>
<table width="100%" border="1" cellspacing="0" cellpadding="4" style="border-color: #dddddd;">
  <tr><th width="25%">Заголовок</th><td>{{ listing.title }}</td></tr>
  <tr><th>Адрес страницы</th><td>{{ listing.url }}</td></tr>
  <tr><th>Цена</th><td>{{ listing.price }}{% if listing.market_count %} (средняя на рынке {{ listing.market }}, объявлений: {{ listing.market_count }}){% endif %}</td></tr>
  <tr><th>Заявлено</th><td>{{ listing.claimed }}</td></tr>
{% if listing.city %}  <tr><th>Город</th><td>{{ listing.city }}</td></tr>
{% endif %}
</table>
{% endif %}

<h2>Тесты</h2>
<table width="100%" border="1" cellspacing="0" cellpadding="4" style="border-color: #dddddd;">
  <tr><th>Тест</th><th>Итог</th><th>Время</th><th>Результат</th></tr>
{% for t in tests %}
  <tr>
    <td>{{ t.name }}</td>
    <td class="status-{{ t.status_key }}">{{ t.status }}</td>
    <td>{{ t.duration }}</td>
    <td>{{ t.summary }}{% for note in t.notes %}<br><span class="small">{{ note }}</span>{% endfor %}</td>
  </tr>
{% endfor %}
</table>

{% for chart in chart_images %}
<p style="margin-top: 10px;"><img src="{{ chart }}" width="{{ chart_width }}" height="{{ chart_height }}"></p>
{% endfor %}

{% if laptop %}
<h2>Ноутбук</h2>
<table width="100%" border="1" cellspacing="0" cellpadding="4" style="border-color: #dddddd;">
{% for label, text in laptop %}
  <tr><th width="25%">{{ label }}</th><td>{{ text }}</td></tr>
{% endfor %}
</table>
{% endif %}

<h2>Железо</h2>
<table width="100%" border="1" cellspacing="0" cellpadding="4" style="border-color: #dddddd;">
{% if system %}
  <tr><th width="25%">Компьютер</th><td>{{ system.manufacturer }} {{ system.model }}{% if system.is_laptop %} (ноутбук){% endif %}</td></tr>
  <tr><th>Windows</th><td>{{ system.os_name }} {{ system.os_version }} ({{ system.architecture }})</td></tr>
  <tr><th>BIOS платы</th><td>{{ system.bios_vendor }} {{ system.bios_version }}{% if system.bios_date %}, {{ system.bios_date[:10] }}{% endif %}</td></tr>
{% endif %}
{% if board %}
  <tr><th>Материнская плата</th><td>{{ board.manufacturer }} {{ board.product }}</td></tr>
{% endif %}
{% if cpu %}
  <tr><th>Процессор</th><td>{{ cpu.name }} — {{ cpu.cores }} ядер / {{ cpu.threads }} потоков{% if cpu.max_clock_mhz %}, {{ cpu.max_clock_mhz }} МГц{% endif %}</td></tr>
{% endif %}
{% if memory %}
  <tr><th>Оперативная память</th><td>{{ (memory.total_mb / 1024) | round(1) }} ГБ
  {% for m in memory.modules %}<br><span class="small">{{ m.slot }}: {{ (m.capacity_mb / 1024) | round(1) }} ГБ {{ m.manufacturer }} {{ m.part_number }} {{ m.speed_mhz or "" }} МГц</span>{% endfor %}</td></tr>
{% endif %}
{% if battery %}
  <tr><th>Батарея</th><td>износ {{ battery.wear_percent }}%, циклов: {{ battery.cycle_count if battery.cycle_count is not none else "—" }} ({{ battery.full_charge_capacity_mwh }} из {{ battery.design_capacity_mwh }} мВт·ч)</td></tr>
{% endif %}
</table>

{% if gpus %}
<h2>Видеокарты</h2>
<table width="100%" border="1" cellspacing="0" cellpadding="3" style="border-color: #dddddd; font-size: 8.5pt;">
  <tr><th>Имя в Windows</th><th>Чип по коду устройства</th><th>Память</th><th>BIOS карты</th><th>Драйвер</th><th>Лимит мощности</th><th>Код</th></tr>
{% for g in gpus %}
  <tr><td>{{ g.name }}</td><td>{{ g.chip }}</td><td>{{ g.vram }}</td><td>{{ g.vbios }}</td><td>{{ g.driver }}</td><td>{{ g.power }}</td><td>{{ g.ids }}</td></tr>
{% endfor %}
</table>
{% endif %}

{% if disks %}
<h2>Накопители</h2>
<table width="100%" border="1" cellspacing="0" cellpadding="3" style="border-color: #dddddd; font-size: 8.5pt;">
  <tr><th>Модель</th><th>Объём</th><th>Тип</th><th>Наработка, ч</th><th>Износ</th><th>Повреждённые участки</th><th>Самодиагностика</th></tr>
{% for d in disks %}
  <tr><td>{{ d.model }}</td><td>{{ d.size }}</td><td>{{ d.type }}</td><td>{{ d.hours }}</td><td>{{ d.wear }}</td><td>{{ d.sectors }}</td><td>{{ d.health }}</td></tr>
{% endfor %}
</table>
{% endif %}

<p class="meta" style="margin-top: 20px;">
  Ни одна программа не даёт 100% гарантии: подготовленный продавец может временно скрыть часть проблем.
  Отчёт снижает риск, но не заменяет здравый смысл — договаривайтесь о гарантии и не переводите деньги заранее.
  <br>Отчёт создан программой {{ app_name }} {{ version }}. Программа ничего не устанавливала на проверяемый компьютер.
</p>

</body>
</html>
